# ==============================================================================
# SENTINEL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with local development values.
# DO NOT commit real secrets, passwords, or production API keys to git.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# PostgreSQL Database Configuration (Future MVP Database)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sentinel_db
DATABASE_USER=sentinel_user
DATABASE_PASSWORD=replace_with_secure_password
DATABASE_URL=postgresql://sentinel_user:replace_with_secure_password@localhost:5432/sentinel_db

# Local Storage Paths (Relative to project root or absolute paths)
STORAGE_BASE_DIR=./storage
STORAGE_UPLOADS_DIR=./storage/uploads
STORAGE_EVIDENCE_DIR=./storage/evidence
STORAGE_REPORTS_DIR=./storage/reports
MAX_UPLOAD_SIZE_BYTES=524288000

# Computer Vision Configuration (Future YOLO & Video Processing)
YOLO_MODEL_PATH=yolov8n.pt
DETECTION_CONFIDENCE_THRESHOLD=0.35
FRAME_SAMPLE_INTERVAL=1.0

# Generative AI / LLM Configuration (Phase 7)
# Note: Do not hardcode actual keys. Provide valid keys in local .env only.
# If no API key is provided, Sentinel seamlessly falls back to Phase 5A deterministic investigation.
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1
